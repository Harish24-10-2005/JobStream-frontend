# ═══════════════════════════════════════════════
# JobStream Frontend — Environment Variables
# ═══════════════════════════════════════════════
# Copy this to .env.local (dev) or provide at build time (Docker)

# Supabase (required — auth & data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API (required — all panel actions)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# App URL (used for auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to false to avoid storing auth session in browser localStorage
NEXT_PUBLIC_AUTH_PERSIST_SESSION=true
