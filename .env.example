# JobStream Frontend Environment Variables
# Copy this to .env.local (dev) or .env (Docker compose)

# Required: Supabase project credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Explicit backend URLs.
# If omitted, frontend auto-detects backend using current host and NEXT_PUBLIC_BACKEND_PORT.
# Example for split-domain deployment:
# NEXT_PUBLIC_API_URL=https://api.example.com
# NEXT_PUBLIC_WS_URL=wss://api.example.com
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# Optional: Backend port used by auto-detection fallback.
NEXT_PUBLIC_BACKEND_PORT=8000

# Required for auth redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to false to avoid storing auth session in localStorage
NEXT_PUBLIC_AUTH_PERSIST_SESSION=true
