{
  "name": "jobstream-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "clean": "node -e \"const fs=require('fs');['.next','node_modules/.cache'].forEach((p)=>fs.rmSync(p,{recursive:true,force:true}));console.log('cleaned');\"",
    "dev:fresh": "npm run clean && npm run dev",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.49.8",
    "lucide-react": "^0.576.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.1.6",
    "typescript": "^5.7.3"
  }
}
